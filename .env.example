# Runtime connection — MUST be the non-superuser app role so Row Level Security applies.
DATABASE_URL=postgres://crm_app:crm_app@localhost:5432/crm_dev
# Owner role used only for migrations and bootstrap.
DATABASE_URL_MIGRATE=postgres://crm:crm@localhost:5432/crm_dev
# Password the bootstrap script assigns to the crm_app role (dev/CI only).
APP_DB_PASSWORD=crm_app

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-bytes
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (not connected until set). Invitations show a copyable link meanwhile.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
